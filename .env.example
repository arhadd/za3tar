# za3tar API keys — copy to .env (gitignored). Keys are read by the Rust core,
# never exposed to the webview.

# ASR — transcription. ElevenLabs Scribe won the code-switching benchmark for
# dialectal Arabic. (Adding a second engine later is one adapter — the seam is
# already there — so we start with just this one.)
ELEVENLABS_API_KEY=

# Notes — turning the transcript into structured notes. This is a different job
# from transcription (ElevenLabs only returns text), so it needs an LLM.
ANTHROPIC_API_KEY=

# Optional: who you are. Helps the notes/actions models attribute "me"
# correctly — essential for in-person recordings (unidentified voices).
ZA3TAR_USER=
